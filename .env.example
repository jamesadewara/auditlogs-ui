# =============================================================================
# auditlogs-ui | compliance dashboard (TanStack Start + Vite)
# Both variables are required; the app refuses to start without them.
# =============================================================================

# auditlogs-auth-api base URL. Its CORS_ALLOWED_ORIGINS must include this
# dashboard's origin, because sign-in uses an httpOnly refresh cookie.
VITE_AUTH_API_URL=http://localhost:8000

# auditlogs-auditing-system-go base URL (api mode). Its CORS_ALLOWED_ORIGINS
# must include this dashboard's origin too.
VITE_AUDIT_API_URL=http://localhost:8005
